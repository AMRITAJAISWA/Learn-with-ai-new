# ==============================================================================
# LearnWithAI Environment Configuration - 100% FREE APIs Everywhere
# ==============================================================================

# 1. AI / LLM Integration (100% FREE - No credit card required)
# OPTION A: Google Gemini Free Tier (RECOMMENDED)
#   - Get your free key in 30 seconds at: https://aistudio.google.com/
#   - Offers 15 Requests/Min, 1,500 Requests/Day for FREE forever without credit card.
GEMINI_API_KEY=""
LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
LLM_MODEL="gemini-1.5-flash"

# OPTION B: Groq Free Cloud Tier
#   - Get your free key at: https://console.groq.com/
#   - Lightning fast Llama 3.3 70B
GROQ_API_KEY=""

# OPTION C: OpenRouter Free Models
#   - Free models like google/gemini-2.0-flash-exp:free
OPENROUTER_API_KEY=""

# OPTION D: Zero-Key Public Free AI (Pollinations.ai) & Built-in Engine
#   - If you leave all AI keys blank, LearnWithAI automatically uses free public
#     endpoints and the built-in pedagogical neural engine with ZERO keys needed!

# 2. YouTube Video Search (100% FREE - Zero API Key Needed)
#   - LearnWithAI includes a built-in zero-key live YouTube search scraper.
#   - It queries live educational tutorials in real time for FREE without any quota.
#   - If you prefer Google Cloud's YouTube Data API v3, you can supply a key:
YOUTUBE_API_KEY=""

# 3. Database (100% FREE Local or Supabase / Neon Free Tier)
#   - Preconfigured with zero-config in-memory dual-layer store.
#   - For PostgreSQL: postgresql://postgres:postgres@localhost:5432/learnwithai?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/learnwithai?schema=public"

# 4. Authentication (100% FREE Demo Mode or Clerk Free Tier)
#   - NEXT_PUBLIC_DEMO_MODE="true" enables 1-click instant login with 0 setup.
NEXT_PUBLIC_DEMO_MODE="true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Clerk Free Tier (up to 10,000 monthly active users free)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
